    "“%@” was permanently deleted on your other device. Delete it here too? This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在你的另一台设备上被永久删除。要在此设备上也删除吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
