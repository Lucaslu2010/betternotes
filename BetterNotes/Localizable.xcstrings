    "%lld notebooks were permanently deleted on your other device:\n%@\nDelete them here too? This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 本笔记本已在你的另一台设备上被永久删除：\n%@\n要在此设备上也删除吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 本筆記本已在你的另一臺裝置上被永久刪除：\n%@\n要在此裝置上也刪除嗎？此操作無法復原。"
          }
        }
      }
    },
