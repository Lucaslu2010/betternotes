// Tracked base config -- safe to commit, defines empty defaults so a
// machine without Local.xcconfig builds identically to today.
//
// Local.xcconfig (gitignored, see .gitignore) can set these three to
// prefill the AI Provider Settings sheet for fast local testing. Never
// commit real credentials -- this file only ever holds the empty defaults.
BN_DEV_BASE_URL =
BN_DEV_MODEL =
BN_DEV_API_KEY =

#include? "../../Local.xcconfig"
