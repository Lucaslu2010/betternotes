<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Debug-only App Transport Security exception.

	  The cloud sync server runs over plain HTTP on the local network during
	  development (e.g. http://192.168.1.106:3000). ATS blocks that by default,
	  which made sync silently fail on device. NSAllowsLocalNetworking permits
	  http to local-network hosts only — public hosts still require https.

	  This file is applied to the Debug configuration only (see project.yml).
	  Release builds use the generated Info.plist with no exception, so a
	  shipping build cannot talk to a plain-http server.

	  Xcode merges the INFOPLIST_KEY_* build settings into this file, so the
	  usage descriptions, scene manifest, launch screen, orientations, and
	  version keys defined in project.yml still apply.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
